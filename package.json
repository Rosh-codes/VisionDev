{
  "name": "visiondev",
  "displayName": "VisionDev",
  "description": "Live visual + behavior debugging for AI coding assistants. Lets Cursor / Claude Code / Copilot / Codex drive a real browser to verify UI changes and report PASS/FAIL with structured evidence.",
  "publisher": "SanidhyaThakur",
  "version": "0.2.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "playwright",
    "browser",
    "testing",
    "visual",
    "cursor",
    "claude",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Rosh-codes/VisionDev.git"
  },
  "bugs": {
    "url": "https://github.com/Rosh-codes/VisionDev/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visiondev.start",
        "title": "VisionDev: Open Panel",
        "category": "VisionDev"
      },
      {
        "command": "visiondev.connect",
        "title": "VisionDev: Connect MCP (Cursor + VS Code Copilot)",
        "category": "VisionDev"
      },
      {
        "command": "visiondev.installAgentsMd",
        "title": "VisionDev: Install Agent Guidance (AGENTS.md)",
        "category": "VisionDev"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('out',{recursive:true});fs.copyFileSync('src/panel.html','out/panel.html');\"",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && npx --yes @vscode/vsce@^2 package --no-yarn",
    "publish:vsce": "npm run compile && npx --yes @vscode/vsce@^2 publish --no-yarn",
    "playwright:install": "npx playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "pixelmatch": "latest",
    "playwright": "latest",
    "pngjs": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.85.0",
    "@types/ws": "latest",
    "typescript": "^5.6.3"
  }
}
